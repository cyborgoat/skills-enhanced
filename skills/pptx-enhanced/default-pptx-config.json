{
  "theme": {
    "name": "Editorial Light",
    "colors": {
      "primary": "#C62828",
      "primaryDark": "#8E0000",
      "primaryLight": "#FFF1F1",
      "secondary": "#FFB300",
      "secondaryLight": "#FFF8E1",
      "accent": "#4E6E8E",
      "background": "#FFFFFF",
      "backgroundAlt": "#FAFAFC",
      "cardBackground": "#FFFFFF",
      "text": {
        "dark": "#1F2937",
        "medium": "#5B6474",
        "light": "#7B8794",
        "onPrimary": "#FFFFFF",
        "onSecondary": "#5D4037",
        "highlight": "#9A6700"
      },
      "border": {
        "primary": "#D7DEE8",
        "secondary": "#E6D7A8",
        "light": "#D7DEE8",
        "subtle": "#EEF2F6"
      }
    },
    "fonts": {
      "title": {
        "family": "Arial",
        "size": 30,
        "weight": "bold",
        "color": "primary"
      },
      "subtitle": {
        "family": "Arial",
        "size": 18,
        "weight": "normal",
        "color": "text.medium"
      },
      "sectionHeader": {
        "family": "Arial",
        "size": 16,
        "weight": "bold",
        "color": "text.dark"
      },
      "contentHeader": {
        "family": "Arial",
        "size": 14,
        "weight": "bold",
        "color": "primary"
      },
      "body": {
        "family": "Arial",
        "size": 12,
        "weight": "normal",
        "color": "text.dark"
      },
      "caption": {
        "family": "Arial",
        "size": 10,
        "weight": "normal",
        "color": "text.medium"
      },
      "label": {
        "family": "Arial",
        "size": 11,
        "weight": "bold",
        "color": "text.dark"
      },
      "mono": {
        "family": "Courier New",
        "size": 10,
        "weight": "normal",
        "color": "text.dark"
      }
    }
  },
  "slideLayouts": {
    "title": "Hero opening with optional highlights panel",
    "section": "Full-colour divider with optional number",
    "agenda": "Numbered rows, 2 columns above 4 items",
    "closing": "Key statement plus 2-4 supporting cards",
    "bullets": "Large bullets with optional aside card",
    "columns": "2-4 accent-topped cards (label, stat, title, text, items)",
    "quote": "Large quote with attribution",
    "codeExplain": "Code block beside numbered explanation",
    "process": "3-5 numbered step cards with arrows and optional callout",
    "timeline": "3-5 dated phases (roadmap)",
    "kpi": "Stat tiles plus native chart and takeaways",
    "chart": "Native chart with takeaways panel",
    "table": "Styled native table with optional highlighted column",
    "comparison": "Product x feature matrix with recommended column and verdict",
    "prosCons": "Two-panel pros and cons with verdict bar",
    "beforeAfter": "Before and after panels",
    "pricingCards": "2-4 plan cards with highlighted recommendation",
    "diagram": "sequence | class | er | state | flow | architecture, native shapes or Mermaid",
    "html": "Hand-written HTML slide",
    "panels": "Mixed-content grid: chart, table, bullets, stats, text, diagram, image, scorecard, chips, callout",
    "insightSummary": "Headline, numbered findings with evidence stats, so-what callout",
    "techDeepDive": "Concept text, diagram or image, metrics strip",
    "benchmark": "Chart, results table, findings, methodology",
    "scorecard": "Weighted criteria table, radar chart, recommendation",
    "riskMatrix": "Risk table with heat-coloured likelihood, impact, severity and mitigation",
    "landscape": "Technology landscape: categories with tagged chips (adopt, trial, assess, hold)",
    "sources": "References in columns"
  },
  "visualElements": {
    "blueprintGrid": {
      "description": "Subtle neutral grid lines in background corners for depth",
      "opacity": 0.04,
      "color": "#C9D1DD"
    },
    "arrows": {
      "style": "filled",
      "color": "primary",
      "headStyle": "triangle"
    },
    "connectors": {
      "style": "solid",
      "color": "primary",
      "width": 2
    },
    "calloutBar": {
      "background": "#FAFAFC",
      "textColor": "#1F2937",
      "iconColor": "#4E6E8E",
      "borderRadius": 4
    },
    "boxes": {
      "borderRadius": 6,
      "borderWidth": 2,
      "padding": 12
    },
    "dividers": {
      "color": "#D7DEE8",
      "width": 1,
      "style": "solid"
    }
  },
  "slideDefaults": {
    "width": 10,
    "height": 5.625,
    "unit": "inches",
    "note": "HTML body is 720pt x 405pt"
  },
  "density": {
