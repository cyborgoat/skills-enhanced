  {
   "type": "diagram",
   "title": "Place order: sequence",
   "subtitle": "Happy path through checkout",
   "kind": "sequence",
   "mode": "native",
   "data": {
    "actors": [
     "Client",
     "Gateway",
     "Orders",
     "Payments",
     "Broker"
    ],
    "messages": [
     {
      "from": "Client",
      "to": "Gateway",
      "text": "POST /orders"
     },
     {
      "from": "Gateway",
      "to": "Orders",
      "text": "createOrder()"
     },
     {
      "from": "Orders",
      "to": "Payments",
      "text": "authorize(card)"
     },
     {
      "from": "Payments",
      "to": "Orders",
      "text": "approved",
      "type": "return"
     },
     {
      "from": "Orders",
      "to": "Orders",
      "text": "persist order"
     },
     {
      "from": "Orders",
      "to": "Broker",
      "text": "OrderPlaced",
      "type": "async"
     },
     {
      "from": "Orders",
      "to": "Gateway",
      "text": "201 Created",
      "type": "return"
     },
     {
      "from": "Gateway",
      "to": "Client",
      "text": "order id",
      "type": "return"
     }
    ]
   },
   "notes": [
    "Payment is **synchronous**",
    "Fulfilment is **async** via the broker",
    "Failures roll back before the event"
   ],
   "notesTitle": "Key points"
  },
